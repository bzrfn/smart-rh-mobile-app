{
  "expo": {
    "name": "rrhh-mobile-app",
    "slug": "rrhh-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "rrhhapp",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La aplicación necesita acceso a la cámara para escanear códigos QR."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rrhh.mobileapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación usa la cámara para registrar asistencia mediante QR."
      }
    },
    "android": {
      "package": "com.rrhh.mobileapp",
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
